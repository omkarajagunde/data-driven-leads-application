# Copy to .env and fill in. .env is gitignored; never commit it.
# Apify API token: https://console.apify.com/account/integrations
APIFY_TOKEN=
# Local Postgres (docker compose up -d). Pick any password; keep the two lines in sync.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://leads:<same password>@localhost:5432/data-driven-leads
# Rupees per US dollar used by the API for dollar prices (seeded once into fx_rates).
FX_INR_PER_USD=88
# API key the frontend dev server sends to the API (create one with src/backend/api_keys.py create "frontend").
FRONTEND_API_KEY=
# Google Geocoding API key, only for src/backend/geocode_pincodes.py (pincode centres).
GOOGLE_API_KEY=
